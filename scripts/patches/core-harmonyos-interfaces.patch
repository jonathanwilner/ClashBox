@@ -0,0 +1,46 @@
+//go:build ohos
+
+package anet
+
+import (
+ "fmt"
+ "net"
+ "sync"
+)
+
+var systemInterfaces struct {
+ sync.RWMutex
+ interfaces []net.Interface
+ addresses map[string][]net.Addr
+}
+
+// SetSystemInterfaces receives local link properties from HarmonyOS's public
+// connection API. Neighbor tables contain remote peers and cannot supply these.
+func SetSystemInterfaces(interfaces []net.Interface, addresses map[string][]net.Addr) {
+ systemInterfaces.Lock()
+ defer systemInterfaces.Unlock()
+ systemInterfaces.interfaces = append([]net.Interface(nil), interfaces...)
+ systemInterfaces.addresses = make(map[string][]net.Addr, len(addresses))
+ for name, addrs := range addresses { systemInterfaces.addresses[name] = append([]net.Addr(nil), addrs...) }
+}
+
+func Interfaces() ([]net.Interface, error) {
+ systemInterfaces.RLock()
+ defer systemInterfaces.RUnlock()
+ if len(systemInterfaces.interfaces) == 0 { return nil, fmt.Errorf("HarmonyOS local link properties have not been supplied") }
+ return append([]net.Interface(nil), systemInterfaces.interfaces...), nil
+}
+
+func InterfaceAddrs() ([]net.Addr, error) {
+ systemInterfaces.RLock()
+ defer systemInterfaces.RUnlock()
+ var result []net.Addr
+ for _, addrs := range systemInterfaces.addresses { result = append(result, addrs...) }
+ return result, nil
+}
+
+func InterfaceAddrsByInterface(ifi *net.Interface) ([]net.Addr, error) {
+ systemInterfaces.RLock()
+ defer systemInterfaces.RUnlock()
+ return append([]net.Addr(nil), systemInterfaces.addresses[ifi.Name]...), nil
+}
