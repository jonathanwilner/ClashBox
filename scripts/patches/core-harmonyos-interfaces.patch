@@ -0,0 +1,27 @@
+//go:build ohos
+
+package anet
+
+import (
+ "net"
+ "testing"
+)
+
+func TestHarmonyLocalLinkAddresses(t *testing.T) {
+ _, v4, _ := net.ParseCIDR("172.20.2.12/16")
+ v4.IP = net.ParseIP("172.20.2.12")
+ _, v6, _ := net.ParseCIDR("2001:db8::12/64")
+ v6.IP = net.ParseIP("2001:db8::12")
+ input := []net.Interface{{Index: 7, Name: "wlan0", MTU: 1500, Flags: net.FlagUp}}
+ SetSystemInterfaces(input, map[string][]net.Addr{"wlan0": {v4, v6}})
+ input[0].Name = "changed"
+ interfaces, err := Interfaces()
+ if err != nil || len(interfaces) != 1 || interfaces[0].Name != "wlan0" { t.Fatalf("interfaces = %v, %v", interfaces, err) }
+ addresses, err := InterfaceAddrsByInterface(&interfaces[0])
+ if err != nil || len(addresses) != 2 || addresses[0].String() != "172.20.2.12/16" || addresses[1].String() != "2001:db8::12/64" { t.Fatalf("addresses = %v, %v", addresses, err) }
+ interfaces[0].Name = "changed"
+ again, _ := Interfaces()
+ if again[0].Name != "wlan0" { t.Fatal("returned interface slice aliases cache") }
+ SetSystemInterfaces(nil, nil)
+ if _, err := Interfaces(); err == nil { t.Fatal("missing initial link properties must return an error") }
+}
