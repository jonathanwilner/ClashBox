@@ -0,0 +1,21 @@
+//go:build with_gvisor && !no_tailscale
+
+package outbound
+
+import (
+ "context"
+ "testing"
+)
+type statusProbe struct { ProxyAdapter; calls int }
+func (p *statusProbe) Name() string { return "probe" }
+func (p *statusProbe) Close() error { return nil }
+func (p *statusProbe) EmbeddedStatus(context.Context, bool) (map[string]any, error) { p.calls++; return map[string]any{"state":"NeedsLogin"}, nil }
+func TestEmbeddedStatusSurvivesAutoCloseWrapper(t *testing.T) {
+ p := &statusProbe{}
+ wrapped := NewAutoCloseProxyAdapter(p)
+ status, ok := wrapped.(interface { EmbeddedStatus(context.Context, bool) (map[string]any, error) })
+ if !ok { t.Fatal("settings capability lost in production wrapper") }
+ reply, err := status.EmbeddedStatus(context.Background(), true)
+ if err != nil || reply["state"] != "NeedsLogin" || p.calls != 1 { t.Fatalf("forwarding failed: %v %v calls=%d", reply, err, p.calls) }
+ if err := wrapped.Close(); err != nil { t.Fatal(err) }
+}
