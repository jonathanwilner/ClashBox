+//go:build with_gvisor && !no_tailscale
+
+package outbound
+
+import (
+	"context"
+	"fmt"
+)
+
+// The parser wraps every outbound; forward this optional settings capability.
+func (p *autoCloseProxyAdapter) EmbeddedStatus(ctx context.Context, login bool) (map[string]any, error) {
+	if status, ok := p.ProxyAdapter.(interface {
+		EmbeddedStatus(context.Context, bool) (map[string]any, error)
+	}); ok {
+		return status.EmbeddedStatus(ctx, login)
+	}
+	return nil, fmt.Errorf("proxy %s does not support embedded Tailscale status", p.Name())
+}
+
+// EmbeddedStatus exposes only enrollment and connectivity information to the
+// local settings page. Auth keys, node keys, and peer identities are excluded.
+func (t *Tailscale) EmbeddedStatus(ctx context.Context, login bool) (map[string]any, error) {
+	if err := t.start(); err != nil {
+		return nil, err
+	}
+	lc, err := t.server.LocalClient()
+	if err != nil {
+		return nil, err
+	}
+	status, err := lc.Status(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if login && status.BackendState != "Running" {
+		if err := lc.StartLoginInteractive(ctx); err != nil {
+			return nil, err
+		}
+		status, err = lc.Status(ctx)
+		if err != nil {
+			return nil, err
+		}
+	}
+	ips := make([]string, 0, len(status.TailscaleIPs))
+	for _, ip := range status.TailscaleIPs {
+		ips = append(ips, ip.String())
+	}
+	return map[string]any{
+		"state": status.BackendState, "authURL": status.AuthURL,
+		"ips": ips, "peers": len(status.Peer), "health": status.Health,
+	}, nil
+}
