+//go:build with_gvisor && !no_tailscale
+
+package adapter
+
+import (
+ "context"
+ "testing"
+ C "github.com/metacubex/mihomo/constant"
+)
+func TestEmbeddedStatusAvailableAfterParseProxy(t *testing.T) {
+ C.SetHomeDir(t.TempDir())
+ proxy, err := ParseProxy(map[string]any{"name":"settings-test", "type":"tailscale", "hostname":"clashbox-test", "state-dir":"embedded-status-test"})
+ if err != nil { t.Fatal(err) }
+ defer proxy.Adapter().Close()
+ if _, ok := proxy.Adapter().(interface { EmbeddedStatus(context.Context, bool) (map[string]any, error) }); !ok { t.Fatal("parsed tailscale proxy hides enrollment status") }
+}
